{
  "name": "webclass-notifier",
  "version": "1.0.0",
  "private": true,
  "description": "大学の WebClass の未提出課題を Discord に知らせるボット（Cloudflare Workers）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "logs": "wrangler tail",
    "typecheck": "tsc",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "wrangler": "^3.84.0"
  }
}
